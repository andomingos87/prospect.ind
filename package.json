{
  "name": "prospect-ai-system",
  "version": "1.0.0",
  "description": "Sistema IA de Prospecção de Indústrias - Automatiza a geração de leads qualificados de indústrias para desenvolvedores e agências de tecnologia",
  "main": "src/index.js",
  "type": "module",
  "author": "Anderson Domingos",
  "license": "ISC",
  "keywords": [
    "prospecting",
    "ai",
    "leads",
    "industrial",
    "automation"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'No build step required for this project'",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --watchAll=false",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src/**/*.js --ext .js",
    "lint:fix": "eslint src/**/*.js --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,json}\"",
    "qa:pre-commit": "npm run lint && npm run format:check && cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --watchAll=false && npm audit --audit-level=moderate",
    "prepare": "husky install",
    "health": "curl http://localhost:3000/health"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.79.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "cross-env": "^10.1.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.0.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "supertest": "^7.1.4"
  }
}
