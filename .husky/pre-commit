#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Verificar se há secrets sendo commitados
if git diff --cached --name-only | grep -E '\.(env|key|pem)$'; then
  echo "❌ Erro: Arquivos sensíveis detectados no commit!"
  echo "Por favor, remova arquivos .env, .key, .pem antes de commitar"
  exit 1
fi

# Verificar arquivos muito grandes (> 1MB)
large_files=$(git diff --cached --name-only | xargs ls -lh 2>/dev/null | awk '{if ($5+0 > 1048576) print $9, $5}' || true)
if [ -n "$large_files" ]; then
  echo "⚠️  Aviso: Arquivos grandes detectados (>1MB):"
  echo "$large_files"
fi

# Executar lint-staged
npx lint-staged

# Executar testes
npm test

