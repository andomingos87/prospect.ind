# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME=Sistema IA de Prospecção de Indústrias

# Database - Supabase
# Required: URL and anon key for client-side/public operations
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Required in production: Service role key for backend operations
# This key bypasses RLS and should NEVER be exposed to frontend
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Search APIs (choose at least one)
# SerpAPI - Primary search API
SERPAPI_KEY=your_serpapi_key

# Serper.dev - Alternative search API
SERPER_API_KEY=your_serper_api_key

# AI APIs (choose at least one)
# Anthropic Claude - Primary AI for classification
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI - Alternative AI for classification
OPENAI_API_KEY=your_openai_api_key

# Data Enrichment APIs (optional)
# Hunter.io - Email finding service
HUNTER_API_KEY=your_hunter_api_key

# Clearbit - Company data enrichment
CLEARBIT_API_KEY=your_clearbit_api_key

# Task Master AI - Optional, for project management
# These keys are used by Task Master AI for task generation and updates
# Only needed if using Task Master features
PERPLEXITY_API_KEY=your_perplexity_api_key_for_research
GOOGLE_API_KEY=your_google_api_key
XAI_API_KEY=your_xai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
MISTRAL_API_KEY=your_mistral_api_key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
OLLAMA_API_KEY=your_ollama_api_key
