# ==============================================
# Application Configuration
# ==============================================
NODE_ENV=development
PORT=3000
APP_NAME="Sistema IA de Prospecção de Indústrias"

# ==============================================
# Database - Supabase
# ==============================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# ==============================================
# Search APIs
# ==============================================
SERPAPI_KEY=your_serpapi_key_here              # SerpAPI for web search
SERPER_API_KEY=your_serper_api_key_here        # Alternative: Serper.dev

# ==============================================
# AI APIs
# ==============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Claude for AI classification
OPENAI_API_KEY=your_openai_api_key_here        # Alternative: OpenAI GPT-4/5

# ==============================================
# Data Enrichment APIs
# ==============================================
HUNTER_API_KEY=your_hunter_api_key_here        # Hunter.io for email enrichment
CLEARBIT_API_KEY=your_clearbit_api_key_here    # Clearbit for company data

# ==============================================
# Task Master AI APIs (Optional)
# ==============================================
PERPLEXITY_API_KEY=your_perplexity_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
MISTRAL_API_KEY=your_mistral_key_here
XAI_API_KEY=YOUR_XAI_KEY_HERE
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
AZURE_OPENAI_API_KEY=your_azure_key_here
OLLAMA_API_KEY=your_ollama_api_key_here
GITHUB_API_KEY=your_github_api_key_here